  m_Script: {fileID: 11500000, guid: 21f9c4a9d48473043aa7a111d4aa8dc6, type: 3}
  m_Name: Dialogue_baguniwoman
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - characterName: "\uC190\uB2D8"
    text: "\uC6B0\uC640\uC544...! \uB0B4 \uBA38\uB9AC \uC704 \uBBFC\uB4E4\uB808\uB4E4\uC774
      \uCDA4\uC744 \uCD94\uACE0 \uC788\uC5B4! \uC5EC\uAE30\uAC00 \uC18C\uBB38\uC73C\uB85C
      \uB4E4\uC740 \uC5C4\uCCAD \uC608\uC05C \uC74C\uC2DD\uC810\uC774\uAD6C\uB098!"
    characterSprite: {fileID: -7343700318681472393, guid: 8a5938494d3ee72418682c5beb0c526d, type: 3}
    characterSprite2: {fileID: 0}
  - characterName: "\uD50C\uB808\uC774\uC5B4 1"
    text: "\uC5B4\uC11C\uC624\uC138\uC694! \uCD5C\uACE0\uC758 \uC74C\uC2DD\uC810!"
    characterSprite: {fileID: -1803160342904494810, guid: 6e0fa5eadf8c8064795c69b97e7405e0, type: 3}
    characterSprite2: {fileID: 0}
  - characterName: "\uD50C\uB808\uC774\uC5B4 2"
    text: "\"\uD55C\uC138\uC720\uD76C\uC9C4\"\uC5D0 \uC5B4\uC11C\uC624\uC138\uC694."
    characterSprite: {fileID: -7918698140010856851, guid: 866642838f9ade648a84182d13de5440, type: 3}
    characterSprite2: {fileID: 0}
  - characterName: "\uC190\uB2D8"
    text: "\uC548\uB155! \uB0B4 \uAF43\uB4E4\uC774 \uB108\uD76C\uB97C \uBCF4\uACE0
      \uBC18\uAC11\uB300! \uC2E4\uC740 \uC5EC\uAE30 \uC624\uB294 \uAE38\uC5D0 \uBC31\uBC1C\uC758
      \uC544\uC8FC \uC740\uC740\uD55C \uD5A5\uAE30\uAC00 \uB098\uB294 \uD560\uC544\uBC84\uC9C0
      \uC170\uD504\uB2D8\uC744 \uB9CC\uB0AC\uAC70\uB4E0? \uB0B4 \uBA38\uB9AC \uC704
      \uAF43\uB4E4\uC774 \uAF2D \uBA39\uC5B4\uBCF4\uACE0 \uC2F6\uC5B4\uD558\uB294
      \uC694\uB9AC\uB97C \uB9C8\uBC95\uCC98\uB7FC \uB9DE\uCDB0\uC8FC\uB294 \uBE44\uBC00\uC758
      \uC694\uB9AC\uC0AC 2\uBA85\uC774 \uC694 \uC55E\uC5D0 \uC0B4\uACE0 \uC788\uB300\uC11C
      \uB180\uB7EC \uC654\uC5B4!"
    characterSprite: {fileID: -7343700318681472393, guid: 8a5938494d3ee72418682c5beb0c526d, type: 3}
    characterSprite2: {fileID: 0}
  - characterName: "\uD50C\uB808\uC774\uC5B4 1"
    text: "\uBB3C\uB860\uC774\uC8E0! \uBA39\uACE0 \uC2F6\uC740\uAC78 \uB9D0\uB9CC
      \uD558\uC138\uC694!"
    characterSprite: {fileID: -1803160342904494810, guid: 6e0fa5eadf8c8064795c69b97e7405e0, type: 3}
    characterSprite2: {fileID: 0}
  - characterName: "\uD50C\uB808\uC774\uC5B4 2"
    text: "\uB531 \uBCF4\uB2C8 \uC2A4\uC2B9\uB2D8\uC774\uAD6C\uB9CC.."
    characterSprite: {fileID: -7918698140010856851, guid: 866642838f9ade648a84182d13de5440, type: 3}
    characterSprite2: {fileID: 0}
  - characterName: "\uD50C\uB808\uC774\uC5B4 1"
    text: "\uCD5C\uACE0\uB85C \uC2E0\uC120\uD55C \uC2DD\uC790\uC7AC \uD2B8\uB7ED\uB9CC
      \uC624\uBA74 \uBC14\uB85C \uC694\uB9AC\uD574\uB4DC\uB9B4\uAC8C\uC694!"
    characterSprite: {fileID: -1803160342904494810, guid: 6e0fa5eadf8c8064795c69b97e7405e0, type: 3}
    characterSprite2: {fileID: 0}
  - characterName: "\uC190\uB2D8"
    text: "\uC6C5? \uC2DD\uC790\uC7AC \uD2B8\uB7ED...? \uD639\uC2DC \uC54C\uB85D\uB2EC\uB85D
      \uBB34\uC9C0\uAC1C\uAF43 \uAC19\uC740 '\uC2E0\uC120\uBB3C\uC0B0' \uD2B8\uB7ED
      \uB9D0\uD558\uB294 \uAC70\uC57C?"
    characterSprite: {fileID: -7343700318681472393, guid: 8a5938494d3ee72418682c5beb0c526d, type: 3}
    characterSprite2: {fileID: 0}
  - characterName: "\uD50C\uB808\uC774\uC5B4 1"
    text: "\uB124!"
    characterSprite: {fileID: -1803160342904494810, guid: 6e0fa5eadf8c8064795c69b97e7405e0, type: 3}
    characterSprite2: {fileID: 0}
  - characterName: "\uC190\uB2D8"
    text: "\uC5B4\uCA4C\uC9C0... \uB0B4 \uC0C8\uC2F9\uB4E4\uC774 \uBC29\uAE08 \uC2AC\uD508
      \uC18C\uC2DD\uC744 \uB4E4\uC5C8\uC5B4. \uADF8 \uD2B8\uB7ED, \uCF54\uB108 \uB3CC\uB2E4\uAC00
      \uB300\uAD74\uB300\uAD74 \uAD74\uB7EC\uC11C \uC2DC\uC6D0\uD558\uAC8C \uC5CE\uC5B4\uC838
      \uBC84\uB838\uB300! \uC644\uC804 \uBD04\uC774 \uCDE8\uC18C\uB41C \uBD84\uC704\uAE30\uC57C...!"
    characterSprite: {fileID: -7343700318681472393, guid: 8a5938494d3ee72418682c5beb0c526d, type: 3}
    characterSprite2: {fileID: 0}
  - characterName: "\uD50C\uB808\uC774\uC5B4 1 & \uD50C\uB808\uC774\uC5B4 2"
    text: "\uC608?????????????????"
    characterSprite: {fileID: -1803160342904494810, guid: 6e0fa5eadf8c8064795c69b97e7405e0, type: 3}
    characterSprite2: {fileID: -7918698140010856851, guid: 866642838f9ade648a84182d13de5440, type: 3}
