--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 21f9c4a9d48473043aa7a111d4aa8dc6, type: 3}
  m_Name: Dialogue_gentleman
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - characterName: "\uC190\uB2D8"
    text: "\uC548\uB155\uD558\uC2ED\uB2C8\uAE4C. \uC81C \uB0B4\uBD80 \uB808\uC774\uB354\uAC00
      \uAC00\uB9AC\uD0A4\uB294 \uBBF8\uC2A4\uD130\uB9AC\uD55C \uC7A5\uC18C\uAC00
      \uBC14\uB85C \uC5EC\uAE30\uAD70\uC694. \uC720\uBA85\uD55C \uC74C\uC2DD\uC810\uC774
      \uD655\uC2E4\uD574 \uBCF4\uC785\uB2C8\uB2E4."
    characterSprite: {fileID: 3427365730743344878, guid: 1d1d07d4445dea04e82f61c96b04bcbf, type: 3}
    characterSprite2: {fileID: 0}
  - characterName: "\uD50C\uB808\uC774\uC5B4 1"
    text: "\uC5B4\uC11C\uC624\uC138\uC694! \uCD5C\uACE0\uC758 \uC74C\uC2DD\uC810!"
    characterSprite: {fileID: -1803160342904494810, guid: 6e0fa5eadf8c8064795c69b97e7405e0, type: 3}
    characterSprite2: {fileID: 0}
  - characterName: "\uD50C\uB808\uC774\uC5B4 2"
    text: "\"\uD55C\uC138\uC720\uD76C\uC9C4\"\uC5D0 \uC5B4\uC11C\uC624\uC138\uC694."
    characterSprite: {fileID: -7918698140010856851, guid: 866642838f9ade648a84182d13de5440, type: 3}
    characterSprite2: {fileID: 0}
  - characterName: "\uC190\uB2D8"
    text: "\uCC98\uC74C \uBD59\uACA0\uC2B5\uB2C8\uB2E4, \uC80A\uC740 \uC870\uB9AC
      \uC7A5\uC778 \uC5EC\uB7EC\uBD84. \uC81C\uAC00 \uBC29\uAE08 \uC804 \uCCA0\uD559\uC801\uC778
      \uACE8\uBAA9\uAE38\uC5D0\uC11C \uBC31\uBC1C\uC758 \uC544\uC8FC \uC815\uC911\uD558\uACE0
      \uAE30\uBB18\uD55C \uC544\uC6B0\uB77C\uAC00 \uB118\uCE58\uB294 \uB9C8\uC2A4\uD130
      \uC170\uD504\uB97C \uC811\uACAC\uD588\uC2B5\uB2C8\uB2E4. \uC81C \uC5F0\uAE30
      \uBC30\uCD9C\uAD6C\uB97C \uB9CC\uC871\uC2DC\uCF1C \uC904 \uCC9C\uC7AC\uC801\uC778
      \uC80A\uC740 \uC694\uB9AC\uC0AC 2\uBA85\uC774 \uC774 \uC88C\uD45C\uC5D0 \uADFC\uBB34
      \uC911\uC774\uB77C\uACE0 \uC815\uC911\uD788 \uC548\uB0B4\uBC1B\uC558\uC2B5\uB2C8\uB2E4."
    characterSprite: {fileID: 3427365730743344878, guid: 1d1d07d4445dea04e82f61c96b04bcbf, type: 3}
    characterSprite2: {fileID: 0}
  - characterName: "\uD50C\uB808\uC774\uC5B4 1"
    text: "\uBB3C\uB860\uC774\uC8E0! \uBA39\uACE0 \uC2F6\uC740\uAC78 \uB9D0\uB9CC
      \uD558\uC138\uC694!"
    characterSprite: {fileID: -1803160342904494810, guid: 6e0fa5eadf8c8064795c69b97e7405e0, type: 3}
    characterSprite2: {fileID: 0}
  - characterName: "\uD50C\uB808\uC774\uC5B4 2"
    text: "\uB531 \uBCF4\uB2C8 \uC2A4\uC2B9\uB2D8\uC774\uAD6C\uB9CC.."
    characterSprite: {fileID: -7918698140010856851, guid: 866642838f9ade648a84182d13de5440, type: 3}
    characterSprite2: {fileID: 0}
  - characterName: "\uD50C\uB808\uC774\uC5B4 1"
    text: "\uCD5C\uACE0\uB85C \uC2E0\uC120\uD55C \uC2DD\uC790\uC7AC \uD2B8\uB7ED\uB9CC
      \uC624\uBA74 \uBC14\uB85C \uC694\uB9AC\uD574\uB4DC\uB9B4\uAC8C\uC694!"
    characterSprite: {fileID: -1803160342904494810, guid: 6e0fa5eadf8c8064795c69b97e7405e0, type: 3}
    characterSprite2: {fileID: 0}
  - characterName: "\uC190\uB2D8"
    text: "\uD760... \uC2DD\uC790\uC7AC\uB97C \uC6B4\uC1A1\uD558\uB294 \uB514\uBC14\uC774\uC2A4(\uD2B8\uB7ED)
      \uB9D0\uC500\uC774\uC2ED\uB2C8\uAE4C? \uD639\uC2DC \uADF8 \uC0C1\uD638\uBA85\uC774
      '\uC2E0\uC120\uBB3C\uC0B0' \uAE30\uCCB4\uC785\uB2C8\uAE4C?"
    characterSprite: {fileID: 3427365730743344878, guid: 1d1d07d4445dea04e82f61c96b04bcbf, type: 3}
    characterSprite2: {fileID: 0}
  - characterName: "\uD50C\uB808\uC774\uC5B4 1"
    text: "\uB124!"
    characterSprite: {fileID: -1803160342904494810, guid: 6e0fa5eadf8c8064795c69b97e7405e0, type: 3}
    characterSprite2: {fileID: 0}
  - characterName: "\uC190\uB2D8"
    text: "\uB300\uB2E8\uD788 \uC720\uAC10\uC2A4\uB7EC\uC6B4 \uC5F0\uAE30\uB97C \uBFDC\uC5B4\uC57C\uACA0\uAD70\uC694.
      \uC81C \uD68C\uB85C\uAC00 \uBC29\uAE08 \uD655\uC778\uD55C \uC0AC\uAC74 \uC9C0\uD3C9\uC120\uC5D0
      \uB530\uB974\uBA74, \uADF8 \uD2B8\uB7ED\uC740 \uC774\uBBF8 \uC911\uB825 \uC81C\uC5B4\uC5D0
      \uC2E4\uD328\uD558\uC5EC \uB3C4\uB85C\uBCC0\uC5D0 \uC2DC\uC6D0\uD558\uAC8C
      \uC5CE\uC5B4\uC838 \uC788\uB294 \uC0C1\uD0DC\uC785\uB2C8\uB2E4."
    characterSprite: {fileID: 3427365730743344878, guid: 1d1d07d4445dea04e82f61c96b04bcbf, type: 3}
    characterSprite2: {fileID: 0}
  - characterName: "\uD50C\uB808\uC774\uC5B4 1 & \uD50C\uB808\uC774\uC5B4 2"
    text: "\uC608?????????????????"
    characterSprite: {fileID: -1803160342904494810, guid: 6e0fa5eadf8c8064795c69b97e7405e0, type: 3}
    characterSprite2: {fileID: -7918698140010856851, guid: 866642838f9ade648a84182d13de5440, type: 3}
